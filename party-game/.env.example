# Copy this file to .env and fill in what you have.
# The game runs fully offline with zero keys set (fallback question bank +
# template lyrics + procedurally-generated instrumental), but it gets much
# funnier with a real Claude key.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for question + lyric generation.
CLAUDE_MODEL=claude-sonnet-5

# Port the party server listens on. Every player's phone will hit
# http://<host-computer-ip>:PORT
PORT=3000

# Length in seconds of the generated instrumental track.
TRACK_SECONDS=26

# Optional: swap in a real music-generation backend later. Leave as "mock"
# to use the built-in, dependency-free synthesizer (default, works offline).
# See lib/music.js for how to plug in another provider.
MUSIC_PROVIDER=mock
