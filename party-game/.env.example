# Copy this file to .env and fill in what you have.
# The game runs fully offline with zero keys set (fallback question bank +
# template lyrics + procedurally-generated instrumental), but it gets much
# funnier with a real Claude key.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for question + lyric generation. claude-haiku-4-5 is the
# cheapest current Claude model ($1/$5 per MTok in/out) and plenty capable
# for short party prompts + song lyrics. Swap in claude-sonnet-5 or
# claude-opus-5 for higher-quality (pricier) writing.
CLAUDE_MODEL=claude-haiku-4-5

# Port the party server listens on. Every player's phone will hit
# http://<host-computer-ip>:PORT
PORT=3000

# Target length in seconds of the generated track. For MUSIC_PROVIDER=
# elevenlabs, each lyric section (Verse/Chorus/...) always gets at least
# 14s regardless of this setting - a short total split across several
# sections wasn't enough time to actually sing the lines, which is why
# tracks used to sound truncated. At the default (60s, ~4 sections) that's
# roughly 900 ElevenLabs credits per song - raise/lower TRACK_SECONDS to
# trade length for cost.
TRACK_SECONDS=60

# Music provider. "mock" (default) = built-in, dependency-free synthesizer,
# instrumental only, works fully offline. "elevenlabs" = real sung vocal
# tracks via ElevenLabs' Eleven Music API, using the actual generated
# lyrics - requires ELEVENLABS_API_KEY and a paid ElevenLabs plan (music
# generation costs credits, roughly 900 credits/minute of audio as of 2026 -
# check https://elevenlabs.io/pricing before enabling this for a big party).
MUSIC_PROVIDER=mock

# Only used when MUSIC_PROVIDER=elevenlabs. Get a key at
# https://elevenlabs.io/ (Workspace settings -> API Keys).
ELEVENLABS_API_KEY=
