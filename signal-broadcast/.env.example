# Copy this file to .env and fill it in.

# Your Signal phone number, with country code.
SIGNAL_ACCOUNT=+15551234567

# Password for the web page. At least 12 characters; longer is better.
# Avoid the $ character, which Docker treats specially in this file.
BROADCAST_PASSWORD=change-me-to-something-long

# The address the page is served at. Its DNS must point at this server.
DOMAIN=signalbroadcast.landhllc.com
