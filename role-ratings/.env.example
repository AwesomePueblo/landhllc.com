# Copy this file to .env and fill in what you have.
# The app works with zero keys set (a small built-in demo dataset), but you
# need a free TMDb key to search and rate real movies/shows.

# Get a free key (the "API Key (v3 auth)" one) at
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Port the server listens on.
PORT=3300
